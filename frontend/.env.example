# The API's origin. Leave it unset — and let vercel.json rewrite /api to the API
# deployment — to keep the browser on a single origin, which avoids CORS
# entirely. Set it only when the two are on unrelated domains and you would
# rather call the API directly.
#
# Baked in at build time: changing it needs a redeploy, not just a restart.
# VITE_API_URL=https://your-api.vercel.app
