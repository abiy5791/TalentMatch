# ============================================================
# API
# ============================================================
PORT=3001
NODE_ENV=development

# Origins allowed to call this API, comma-separated. Set this to your deployed
# frontend domain(s). Unset means "reflect whatever asked", which is fine for
# local work and is not what you want in production.
CORS_ORIGIN=http://localhost:5173

# ============================================================
# Database
# ============================================================
# A hosted provider gives you one connection string — prefer it, and point it at
# the *pooled* endpoint (pgbouncer / Neon's -pooler host) for serverless.
# When DATABASE_URL is set the five DB_* variables below are ignored.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=recruitment

# TypeORM owns the schema in development. Defaults to false in production and on
# serverless, where cold-starting instances would race each other altering it —
# there, run `npm run db:schema` once, deliberately, from your machine.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# TLS. Defaults on for serverless and for any DATABASE_URL that asks for it.
# DB_SSL=true
# Set true only if your provider gives a chain the Node trust store carries.
# DB_SSL_REJECT_UNAUTHORIZED=false

# Connections per instance. On serverless every concurrent instance opens its
# own pool, so this stays at 1 and real pooling happens at the pooled endpoint.
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000

# ============================================================
# Uploaded CVs
# ============================================================
# Where the bytes go: "fs" (a directory) or "db" (a bytea column). Defaults to
# "db" on serverless, where the filesystem is read-only apart from a /tmp that
# is discarded with the instance, and "fs" everywhere else.
# RESUME_STORAGE=fs

# Only used by the "fs" driver. Must be a directory the API can write to and
# that nothing serves statically — the only route to these files is
# GET /resumes/:id, which checks the caller. Defaults to ./storage/resumes.
UPLOAD_DIR=./storage/resumes

# Size ceiling for one CV, in MB. Defaults to 5, or 4 on serverless because the
# platform rejects a larger request body before the function ever sees it.
# MAX_RESUME_MB=5

# ============================================================
# Seeding
# ============================================================
# Load the demo dataset on boot when the database is empty. Defaults to true
# locally and false on serverless, where every cold start is a "boot".
# Use `npm run db:seed` to load it into a deployed database.
# SEED_ON_BOOT=true

# ============================================================
# Auth - change this before deploying anywhere real
# ============================================================
JWT_SECRET=recruitment-secret-key-change-in-production
JWT_EXPIRES_IN=7d
